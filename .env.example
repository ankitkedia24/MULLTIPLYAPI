# ============================================================
# Mulltiply Item Sync — environment configuration
# Copy to .env and fill in the values. NEVER commit .env.
# ============================================================

# --- AMITCLOUD ERP (Supabase) — READ ONLY access to books ---
SUPABASE_URL=https://vlfogshdsrkqdeqaguqr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Mulltiply API (they provide the key) ---
# For local testing point BASE_URL at the mock server (npm run mock).
# For go-live: MULLTIPLY_BASE_URL=https://api.mulltiply.com
MULLTIPLY_BASE_URL=http://localhost:4010
MULLTIPLY_API_KEY=test-key

# --- Our own admin API ---
# Protects POST /sync, GET /preview, GET /status with the x-admin-key header.
ADMIN_API_KEY=
PORT=3000

# --- Mapping knobs (defaults shown; all optional) ---
SYNC_HSN_CODE=4901
SYNC_GST_PERCENT=0
SYNC_UNIT_NAME=PCS
# Which ERP price column becomes sellingPrice:
# sale_rate | sale_retail_price | sale_net_price | sale_wholesale_price
SYNC_PRICE_FIELD=sale_rate
# Which books to sync: active (all active books) | in_stock (active AND closing_stock > 0)
SYNC_BOOK_FILTER=active
SYNC_VARIANT_TYPE1=Binding
SYNC_VARIANT_TYPE2=Language
SYNC_CATEGORY_FALLBACK=BOOKS
SYNC_SUBCATEGORY_FALLBACK=GENERAL

# --- Batching / resilience ---
SYNC_BATCH_SIZE=300
SYNC_BATCH_DELAY_MS=500
SYNC_MAX_RETRIES=5

# Look-back window (minutes) for an incremental run when no watermark exists
# (e.g. right after a deploy wiped DATA_DIR). Incrementals NEVER fetch the
# whole catalogue; the nightly full sync reconciles anything older.
SYNC_INCR_WINDOW_MINUTES=60

# --- Scheduler (inside the API server process) ---
SYNC_SCHEDULE_ENABLED=false
# Hour of day (0-23, server local time) for the nightly FULL sync
SYNC_FULL_HOUR=2
# Minutes between INCREMENTAL syncs (0 = disabled)
SYNC_INCR_MINUTES=30

# --- Where state.json and run reports are written ---
DATA_DIR=./data

# --- Mock Mulltiply server only (npm run mock) ---
MOCK_PORT=4010
MOCK_API_KEY=test-key
# Chaos testing: reject every Nth row / return HTTP 500 every Nth request (0 = off)
MOCK_FAIL_ROW_EVERY=0
MOCK_500_EVERY=0

# --- Phase 2: stock-only routing via Mulltiply's inventory API ---
# Incrementals send pure stock changes as compact batches to
# POST /v2/godowns/thirdparty-stock-sync instead of full item objects.
SYNC_STOCK_API_ENABLED=true
SYNC_STOCK_BATCH_SIZE=500
SYNC_STOCK_SYNCID_PREFIX=external://variant/
